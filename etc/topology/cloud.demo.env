# cloud.demo — cloud independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema/user `sdkwork_edu_demo`
# and a dedicated Redis logical DB index so no cache key ever collides with another shared-redis environment.
SDKWORK_EDU_DEPLOYMENT_PROFILE=cloud
SDKWORK_EDU_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_EDU_PROFILE_ID=cloud.demo
SDKWORK_EDU_APPLICATION_PUBLIC_HTTP_URL=https://edu-demo.sdkwork.com
SDKWORK_EDU_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
SDKWORK_EDU_WEB_DEV_INGRESS_BIND=127.0.0.1:5257
SDKWORK_EDU_PC_INTERNAL_DEV_PORT=5249
SDKWORK_EDU_H5_INTERNAL_DEV_PORT=5250


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_EDU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
SDKWORK_CORS_ALLOWED_ORIGINS=https://edu-demo.sdkwork.com,http://edu-demo.sdkwork.com,https://edu-demo.birdcoder.com,http://edu-demo.birdcoder.com,https://edu-demo.dtupay.com,http://edu-demo.dtupay.com,https://edu-demo.noaper.com,http://edu-demo.noaper.com,https://edu-demo.sdkwork.cn,http://edu-demo.sdkwork.cn,https://edu-demo.birdcoder.cn,http://edu-demo.birdcoder.cn,https://edu-demo.dtupay.cn,http://edu-demo.dtupay.cn,https://edu-demo.noaper.cn,http://edu-demo.noaper.cn,https://edu-demo.skubc.com,http://edu-demo.skubc.com,https://edu-demo.skubc.cn,http://edu-demo.skubc.cn,https://edu-demo.zowalk.com,http://edu-demo.zowalk.com,https://edu-demo.zowalk.cn,http://edu-demo.zowalk.cn,https://edu-demo.offer86.com,http://edu-demo.offer86.com,https://edu-demo.offer86.cn,http://edu-demo.offer86.cn,https://edu-demo.86offer.com,http://edu-demo.86offer.com,https://edu-demo.86offer.cn,http://edu-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
