# Bootstrap profile standalone.production — replace with application-specific values.
SDKWORK_EDU_DEPLOYMENT_PROFILE=standalone
SDKWORK_EDU_ENVIRONMENT=production
SDKWORK_EDU_PROFILE_ID=standalone.production
SDKWORK_EDU_APPLICATION_PUBLIC_HTTP_URL=https://edu.sdkwork.com
SDKWORK_EDU_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:3910
SDKWORK_EDU_PC_STATIC_ROOT=/usr/share/sdkwork/edu/web/pc


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_EDU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
