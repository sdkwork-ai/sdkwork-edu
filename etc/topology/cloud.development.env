# Bootstrap profile cloud.development — replace with application-specific values.
SDKWORK_EDU_DEPLOYMENT_PROFILE=cloud
SDKWORK_EDU_ENVIRONMENT=development
SDKWORK_EDU_PROFILE_ID=cloud.development
SDKWORK_EDU_APPLICATION_PUBLIC_HTTP_URL=https://edu-dev.sdkwork.com
SDKWORK_EDU_PLATFORM_API_GATEWAY_HTTP_URL=https://api-dev.sdkwork.com
SDKWORK_EDU_WEB_DEV_INGRESS_BIND=127.0.0.1:5257
SDKWORK_EDU_PC_INTERNAL_DEV_PORT=5249
SDKWORK_EDU_H5_INTERNAL_DEV_PORT=5250


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_EDU_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN


# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL of the local application ingress started by its own dev command
# (bind 127.0.0.1:3910), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3910
SDKWORK_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5257,http://localhost:5257,https://edu-dev.sdkwork.com,http://edu-dev.sdkwork.com,https://edu-dev.birdcoder.com,http://edu-dev.birdcoder.com,https://edu-dev.dtupay.com,http://edu-dev.dtupay.com,https://edu-dev.noaper.com,http://edu-dev.noaper.com,https://edu-dev.sdkwork.cn,http://edu-dev.sdkwork.cn,https://edu-dev.birdcoder.cn,http://edu-dev.birdcoder.cn,https://edu-dev.dtupay.cn,http://edu-dev.dtupay.cn,https://edu-dev.noaper.cn,http://edu-dev.noaper.cn,https://edu-dev.skubc.com,http://edu-dev.skubc.com,https://edu-dev.skubc.cn,http://edu-dev.skubc.cn,https://edu-dev.zowalk.com,http://edu-dev.zowalk.com,https://edu-dev.zowalk.cn,http://edu-dev.zowalk.cn,https://edu-dev.offer86.com,http://edu-dev.offer86.com,https://edu-dev.offer86.cn,http://edu-dev.offer86.cn,https://edu-dev.86offer.com,http://edu-dev.86offer.com,https://edu-dev.86offer.cn,http://edu-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,dsh-app://app,tauri://localhost,https://servicewechat.com
