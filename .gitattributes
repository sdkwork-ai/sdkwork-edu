# SDKWork line-ending policy (SHELL_PORTABILITY_SPEC / MODULE_BIN_SPEC).
# Shell scripts must be LF: a CRLF shebang fails on Linux with
# "/usr/bin/env: 'bash\r': No such file or directory".
* text=auto eol=lf
*.sh text eol=lf
*.bash text eol=lf
*.env text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.conf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.rs text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary